#!name= 反广告 · 知乎补丁
#!desc= 知乎广告专用 · 官方 ZhihuAds 规则内联（域名层 + URL 层）· ⚠️ 必须开 HTTPS 解密才生效
#!author= ace1892 · 仓库 https://github.com/ace1892/shadowrocket-antidad
#!icon= https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/AdBlack.png

[Rule]
# ==========================================================================
# 本文件由 scripts/build.py 生成于 2026-09-28 14:23 (UTC+8)
# 不要直接改这里 —— 改 whitelist.txt 或 sources.json，然后重新构建。
# 源基线日期：2026-09-21
# 白名单：本档全是 URL 层规则，没有任何域名级 REJECT，故不注入白名单
#
# 生效前提：小火箭「全局路由」必须设为「配置」，含 [Rule] 的模块才工作。
# ⚠️ 本模块需要开「HTTPS 解密」并信任根证书（含 URL 重写 / URL-REGEX）。
# ==========================================================================

# --------------------------------------------------------------------------
# ① 知乎广告 · 域名/IP 层（官方 ZhihuAds，内联）
#     内联 13 条 / 1,281 字节（不远程引用，规避上游重组目录导致的静默失效）
#     来源 https://github.com/blackmatrix7/ios_rule_script
#     ★ 2026-09-28 从原 zhihu-inline 拆出：这 4 条是**连接层 REJECT**（域名 + IP 段），
#     不需要 MITM，属于域名级模块的活。原先放在「重写整合」里 → 该模块变成「URL 
#     级却带域名级规则」，且只装它的人会漏拦这 4 条。现归 antidad-full / strict / zhihu。
#     原第 5 条的 `DOMAIN,appcloud2.in.zhihu.com,REJECT` **已删除** —— 实测该域已躺在 
#     blackmatrix7 Advertising 域名集里（anti-AD 亦有），域名级模块早已整域 REJECT，
#     留着就是跨模块死代码。若上游哪天移除该域，看本节记录补回。注：本源的 measured 
#     记的是**上游 .sgmodule 的条数（13）**、不是本源的 4 条 —— 拆成两源后仍共用同一个 url，
#     verify.py 因此对两者做的是「上游文件漂移」监控（内联源不跟随上游更新，
#     这里只用于发现上游重写）。
# --------------------------------------------------------------------------
DOMAIN,mqtt.zhihu.com,REJECT
DOMAIN,sugar.zhihu.com,REJECT
IP-CIDR,118.89.204.198/32,REJECT-DROP,no-resolve
IP-CIDR,2402:4e00:1200:ed00:0:9089:6dac:96b6/128,REJECT-DROP,no-resolve

# --------------------------------------------------------------------------
# ② 知乎广告 · URL 层（官方 ZhihuAds，内联）
#     内联 13 条 / 1,281 字节（不远程引用，规避上游重组目录导致的静默失效）
#     来源 https://github.com/blackmatrix7/ios_rule_script
#     ★ 2026-09-28 从原 zhihu-inline 拆出：7 条 URL-REGEX + 1 条 USER-AGENT，
#     都是**必须解密才生效**的规则，留在 URL 级模块。USER-AGENT 单独说明：HTTPS 下 UA 
#     在密文里，**不开解密读不到**，所以它同属 URL 层、
#     不能挪去域名级模块（挪过去就永远失效）。规则为**内联**而非 RULE-SET 引用：上游 
#     blackmatrix7 会重组目录，本项目已亲历一次『模块引用路径被删而静默死亡』；此套规则自 
#     2025-06 未变更、仅 1.3 KB，内联可彻底消除 404 风险。www.zhihu.com 为规则所需，官方 
#     ZhihuAds_MITM 只声明了 api.zhihu.com 与 zhuanlan.zhihu.com，此处已补。注：measured 
#     记的是上游 .sgmodule 的 13 条（两源共用同一 url，verify.py 做的是上游漂移监控），
#     本源实际 8 条。
# --------------------------------------------------------------------------
URL-REGEX,^https?:\/\/(api\.zhihu\.com|(103\.41\.167\.(226|234|235|236)))\/brand\/question\/\d+/card\?,REJECT
URL-REGEX,^https?:\/\/(api\.zhihu\.com|(103\.41\.167\.(226|234|235|236)))\/commercial_api\/launch_v2\?,REJECT
URL-REGEX,^https?:\/\/(api\.zhihu\.com|(103\.41\.167\.(226|234|235|236)))\/explore\/entry\/tips,REJECT-TINYGIF
URL-REGEX,^https?:\/\/(www\.zhihu\.com|(103\.41\.167\.(226|234|235|236)))\/api\/v4/(questions|anwsers)\/\d+/related-readings,REJECT-TINYGIF
URL-REGEX,^https?:\/\/(www\.zhihu\.com|(103\.41\.167\.(226|234|235|236)))\/api\/v4\/answers\/\d+\/recommendations,REJECT
URL-REGEX,^https?:\/\/(www\.zhihu\.com|(103\.41\.167\.(226|234|235|236)))\/commercial_api\/banners_v3\/mobile_banner,REJECT-TINYGIF
URL-REGEX,^https?:\/\/zhuanlan\.zhihu\.com\/api\/articles\/\d+\/recommendation,REJECT-TINYGIF
USER-AGENT,AVOS*,REJECT

[MITM]
# %APPEND% = 追加到现有解密列表，不覆盖其它模块（含配置里已有的声明）。
# `-` 前缀 = 排除；已统一排在末尾（先声明、后排除）。
hostname = %APPEND% api.zhihu.com,www.zhihu.com,zhuanlan.zhihu.com,103.41.167.226,103.41.167.234,103.41.167.235,103.41.167.236

# --------------------------------------------------------------------------
# 备注
# --------------------------------------------------------------------------
# · ⚠️ 未开「HTTPS 解密」+ 未信任根证书时，[URL Rewrite] 与 URL-REGEX 规则**静默不生效**（小火箭不报错）。
# · 解密范围见上方 [MITM]。长期不用请直接卸载本模块，避免白付解密开销。
# · 本模块**不含域名级规则**（也没有白名单）—— 域名级拦截请装「反广告 · 整合版」。
